          "id": "stripe_payments",
          "schema": "https://ucp.stripe.com/payments/2026-06-25/schema.json",
          "spec": "https://docs.stripe.com/agentic-commerce/ucp/stripe-payments-handler",
          "version": "2026-06-25"
        }
      ]
    },
    "services": {},
    "supported_versions": [
      "2026-04-08",
      "2026-08-25"
