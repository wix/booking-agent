          "version": "2026-08-25"
        }
      ],
      "dev.ucp.shopping.checkout": [
        {
          "schema": "https://ucp.dev/latest/schemas/shopping/checkout.json",
          "spec": "https://ucp.dev/latest/specification/shopping/checkout/",
          "version": "2026-08-25"
        },
        {
          "schema": "https://ucp.dev/latest/schemas/shopping/checkout.json",
          "spec": "https://ucp.dev/latest/specification/shopping/checkout/",
          "version": "2026-04-08"
        }
      ],
      "dev.ucp.shopping.order": [
        {
          "schema": "https://ucp.dev/latest/schemas/shopping/order.json",
          "spec": "https://ucp.dev/latest/specification/shopping/order",
          "version": "2026-08-25"
        }
      ],
      "dev.usp-protocol.services.paid_bookings": [
        {
          "extends": "dev.ucp.shopping.checkout",
