# Shipped defaults for booking-agent-core. Do not edit this copy.
#
# Every variable the core library reads is listed here with its default. To override
# one, set it in the process environment or in ~/.booking-agent/.env (run
# `booking-agent config init` to create that file). Lines starting with `# NAME=` have
# no default: they are per-install or runtime values, documented here only.
#
# Values obtained at runtime (calendar tokens, Link tokens, booking keys, the buyer's
# device IP) never go in any env file.

# --- Platform identity -------------------------------------------------------
# Identity URI sent in the USP-Agent / UCP-Agent headers. Businesses fetch it.
USP_AGENT_PROFILE_URL=https://profile.booking-agent.dev/platform-profile.json
# Service registry search endpoint.
USP_REGISTRY_URL=https://www.wixapis.com/_api/usp-registry/registry/search_services
# Platform name and contact sent to businesses.
USP_PLATFORM_NAME=USP Agent
USP_PLATFORM_CONTACT=support@booking-agent.dev
# Where a business sends the buyer after an off-platform step.
USP_PLATFORM_RETURN_URL=https://booking-agent.dev/return
# Path of the OAuth token store for businesses that require sign-in.
# USP_TOKEN_STORE_PATH=

# --- Install settings ----------------------------------------------------------
# Folder for sessions, tokens, and traces (default ~/.booking-agent).
# BOOKING_AGENT_SESSION_DIR=
# Set to 1 only when the CLI runs on the buyer's own device (sends the device IP).
# BOOKING_AGENT_RUNS_ON_BUYER_DEVICE=

# --- Authorization -------------------------------------------------------------
# Booking-scoped credential floor for privileged operations: required | preferred | disabled.
BOOKING_AGENT_USP_AUTH_SCOPED_CREDENTIAL=required
# Operator-only bearer tokens for staging businesses that need one.
# BOOKING_AGENT_USP_MERCHANT_BEARER=
# BOOKING_AGENT_UCP_MERCHANT_BEARER=
# BOOKING_AGENT_PROFILE_FETCH_BEARER=

# --- HTTP ------------------------------------------------------------------------
# Per-request deadline and connect timeout, in seconds.
BOOKING_AGENT_HTTP_TIMEOUT=15
BOOKING_AGENT_HTTP_CONNECT_TIMEOUT=5
# Retries on rate limits and transient errors, with exponential backoff (seconds).
BOOKING_AGENT_HTTP_MAX_RETRIES=4
BOOKING_AGENT_HTTP_BACKOFF_BASE=1.0
BOOKING_AGENT_HTTP_BACKOFF_MAX=300.0
# Per-host circuit breaker.
BOOKING_AGENT_CIRCUIT_FAILURE_THRESHOLD=5
BOOKING_AGENT_CIRCUIT_COOLDOWN_SECONDS=30
BOOKING_AGENT_CIRCUIT_DISABLED=0
# Minimum spacing between request starts to one business host, in milliseconds.
BOOKING_AGENT_MERCHANT_REQUEST_DELAY_MS=200
# Requests in flight to one business host at a time.
BOOKING_AGENT_MERCHANT_HOST_CONCURRENCY=3
# Businesses checked in parallel during discovery.
BOOKING_AGENT_DISCOVERY_CONCURRENCY=8
# How long a fetched business profile is reused, in seconds.
BOOKING_AGENT_PROFILE_CACHE_TTL_SECONDS=900
# Redacted request log at <session dir>/http_trace.log (1 to enable) and its size cap.
BOOKING_AGENT_HTTP_TRACE=0
BOOKING_AGENT_HTTP_TRACE_MAX_BYTES=5242880

# --- Google Calendar -------------------------------------------------------------
# The operator's OAuth app. Needed only for calendar checking with a local sign-in.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# Local sign-in callback.
GOOGLE_CALENDAR_REDIRECT_PORT=8098
# GOOGLE_CALENDAR_OAUTH_REDIRECT_BASE_URL=http://localhost:8098
# GOOGLE_CALENDAR_DOMAIN=
# GOOGLE_CALENDAR_SSL_CERTFILE=
# GOOGLE_CALENDAR_SSL_KEYFILE=
# Saved calendar tokens: a folder under the session dir, or an absolute path.
GOOGLE_CALENDAR_TOKEN_CACHE_DIR=.google-calendar-tokens

# --- Runtime only (set by the host per process, never in a file) -----------------
# BOOKING_AGENT_BUYER_DEVICE_IP=
