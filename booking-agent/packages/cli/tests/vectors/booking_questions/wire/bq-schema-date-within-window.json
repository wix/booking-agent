{
  "id": "bq-schema-date-within-window",
  "section": "11.4.3",
  "requirement": "date-bound-window",
  "kind": "wire",
  "binding": [
    "rest",
    "mcp"
  ],
  "expect": "accept",
  "schema": "booking_questions.json#/$defs/BookingQuestion",
  "notes": "A window from the request date to 30 days later. Both bounds are inclusive.",
  "case": "within the next 30 days",
  "instance": {
    "kind": "question",
    "id": "pref_date",
    "label": {
      "plain": "Preferred date"
    },
    "schema": {
      "type": "string",
      "format": "date",
      "not_before": "P0D",
      "not_after": "P30D"
    },
    "required": true
  },
  "then": {
    "conforming": true,
    "schema_valid": true,
    "member_name_violations": []
  },
  "answer_cases": [
    {
      "value": "2026-11-24",
      "request_date": "2026-10-25",
      "valid": true
    },
    {
      "value": "2026-11-25",
      "request_date": "2026-10-25",
      "valid": false,
      "errors": [
        "not_after"
      ]
    },
    {
      "value": "2026-10-24",
      "request_date": "2026-10-25",
      "valid": false,
      "errors": [
        "not_before"
      ]
    }
  ],
  "variants": [
    {
      "case": "absolute bounds",
      "expect": "accept",
      "instance": {
        "kind": "question",
        "id": "pref_date",
        "label": {
          "plain": "Preferred date"
        },
        "schema": {
          "type": "string",
          "format": "date",
          "not_before": "2026-11-01",
          "not_after": "2026-11-30"
        },
        "required": true
      },
      "then": {
        "conforming": true,
        "schema_valid": true,
        "member_name_violations": []
      },
      "answer_cases": [
        {
          "value": "2026-11-30",
          "request_date": "2026-10-25",
          "valid": true
        },
        {
          "value": "2026-10-31",
          "request_date": "2026-10-25",
          "valid": false,
          "errors": [
            "not_before"
          ]
        }
      ]
    }
  ],
  "wrong_answers": [
    {
      "behaviour": "treat P30D as exclusive",
      "violates": "11.4.3 Date bounds",
      "why": "Both bounds are inclusive; an exclusive reading rejects the last day the business offered."
    }
  ]
}
