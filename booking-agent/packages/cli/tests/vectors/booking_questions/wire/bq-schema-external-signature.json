{
  "id": "bq-schema-external-signature",
  "section": "11.4.3",
  "requirement": "external-task-signature",
  "kind": "wire",
  "binding": [
    "rest",
    "mcp"
  ],
  "expect": "accept",
  "schema": "booking_questions.json#/$defs/BookingQuestionExternalTask",
  "notes": "A signature task is business-hosted work completed through a session-specific continue_url. It has collection business_surface and never carries an answer value.",
  "case": "signature task",
  "instance": {
    "kind": "external_task",
    "id": "signature_task",
    "label": {
      "plain": "Sign the treatment waiver"
    },
    "task_type": "signature",
    "required": true,
    "collection": "business_surface"
  },
  "then": {
    "conforming": true,
    "schema_valid": true,
    "member_name_violations": []
  },
  "variants": [
    {
      "case": "unknown task type",
      "expect": "reject",
      "instance": {
        "kind": "external_task",
        "id": "signature_task",
        "label": {
          "plain": "Sign the treatment waiver"
        },
        "task_type": "drawing",
        "required": true,
        "collection": "business_surface"
      },
      "then": {
        "conforming": false,
        "schema_valid": false,
        "member_name_violations": []
      }
    }
  ],
  "wrong_answers": [
    {
      "behaviour": "accept the signature as a base64 answer",
      "violates": "11.4.10 Privacy and Safety",
      "why": "Files and signatures would flow through agent context and logs."
    }
  ]
}
