  "expect": "accept",
  "schema": "booking_questions.json#/$defs/BookingQuestion",
  "notes": "Single choice is a string with oneOf {const, title} options: at most 50, each const unique.",
  "case": "hair length",
  "instance": {
    "kind": "question",
    "id": "hair_length",
    "label": {
      "plain": "Hair length"
    },
    "schema": {
      "type": "string",
      "oneOf": [
        {
          "const": "short",
          "title": "Short"
        },
        {
          "const": "medium",
          "title": "Medium"
        },
        {
          "const": "long",
          "title": "Long"
        }
      ]
    },
    "required": true,
    "rendering": "radio"
  },
  "then": {
    "conforming": true,
    "schema_valid": true,
    "member_name_violations": []
  },
  "answer_cases": [
    {
      "value": "medium",
      "valid": true
    },
    {
      "value": "xl",
      "valid": false,
      "errors": [
        "option"
      ]
    },
    {
      "value": [
        "medium"
      ],
      "valid": false,
      "errors": [
        "type"
      ]
    }
  ],
