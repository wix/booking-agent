{
  "id": "bq-flow-answer-missing",
  "section": "11.4.9",
  "requirement": "booking-question-answer-missing",
  "kind": "flow",
  "expect": "reject",
  "outcome_code": "booking_question_answer_missing",
  "notes": "A required answer is absent at create. The business reports it at a bracket-form question path and creates nothing: no booking, no hold change, no payment, and no Action. The platform asks only for the missing answer and retries against the same hold.",
  "given": {
    "service": {
      "id": "svc_cut_45",
      "type": "appointment",
      "booking_question_sets": [
        {
          "id": "intake",
          "revision": "r1",
          "purpose": "intake",
          "completion_timing": "before_confirmation",
          "frequency": "every_booking",
          "items": [
            {
              "kind": "question",
              "id": "hair_notes",
              "label": {
                "plain": "Anything the stylist should know?"
              },
              "schema": {
                "type": "string",
                "maxLength": 500
              },
              "required": true
            },
            {
              "kind": "question",
              "id": "hair_length",
              "label": {
                "plain": "Hair length"
              },
              "schema": {
                "type": "string",
                "oneOf": [
                  {
                    "const": "short",
                    "title": "Short"
                  },
                  {
                    "const": "medium",
                    "title": "Medium"
                  },
                  {
                    "const": "long",
                    "title": "Long"
                  }
                ]
              },
              "required": true
            }
          ]
        }
      ]
    },
    "hold": {
      "id": "hold_bq_1",
      "slot_id": "slot_20261028_1000",
      "service_id": "svc_cut_45",
      "spots": 1,
      "expires_at": "2026-10-25T10:10:00Z",
      "status": "active"
    }
  },
  "when": [
    {
      "at": "2026-10-25T10:00:00Z",
      "step": "create_booking",
      "with": {
        "hold_id": "hold_bq_1",
        "buyer": {
          "first_name": "Dana",
          "last_name": "Levi",
          "email": "dana@example.com",
          "phone_number": "+14155550123"
        },
        "booking_question_submissions": [
          {
            "set_id": "intake",
            "revision": "r1",
            "answers": {
              "hair_length": "medium"
            }
          }
        ]
      },
      "result": {
        "accepted": false,
        "booking_created": false,
        "messages": [
          {
            "type": "error",
            "code": "booking_question_answer_missing",
            "content": "This answer is required.",
            "severity": "recoverable",
            "path": "$.booking_question_submissions[?@.set_id=='intake'].answers['hair_notes']"
          }
        ]
      }
    }
  ],
  "then": {
    "booking_created": false,
    "hold": {
      "id": "hold_bq_1",
      "status": "active",
      "expires_at": "2026-10-25T10:10:00Z"
    },
    "slot_capacity_held": 1,
    "payment_authorized": false,
    "actions_created": [],
    "http_status": 200,
    "outcome_code": "booking_question_answer_missing",
    "platform_may_retry": true,
    "lookup_by_any_returned_identifier": "not_found"
  },
  "wrong_answers": [
    {
      "behaviour": "create a pending booking that waits for the answer",
      "violates": "11.4.7 Before confirmation",
      "why": "Capacity is consumed by a booking that cannot be confirmed, and it outlives the buyer's session."
    },
    {
      "behaviour": "release the hold on a recoverable failure",
      "violates": "11.4.11 business item 8",
      "why": "The buyer loses the slot for a typo-level mistake."
    }
  ]
}
