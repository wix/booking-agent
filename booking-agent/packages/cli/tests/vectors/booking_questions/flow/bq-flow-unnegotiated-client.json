{
  "id": "bq-flow-unnegotiated-client",
  "section": "11.4.2",
  "requirement": "booking-questions-unnegotiated",
  "kind": "flow",
  "expect": "accept",
  "notes": "A platform that did not negotiate the extension books a service with a required intake set. The business uses its business-surface handoff and emits no Section 11.4.9 code; the extension fields are inert for this platform.",
  "given": {
    "service": {
      "id": "svc_cut_45",
      "type": "appointment",
      "booking_question_sets": [
        {
          "id": "intake",
          "revision": "r1",
          "purpose": "intake",
          "completion_timing": "before_confirmation",
          "frequency": "every_booking",
          "items": [
            {
              "kind": "question",
              "id": "hair_notes",
              "label": {
                "plain": "Anything the stylist should know?"
              },
              "schema": {
                "type": "string",
                "maxLength": 500
              },
              "required": true
            },
            {
              "kind": "question",
              "id": "hair_length",
              "label": {
                "plain": "Hair length"
              },
              "schema": {
                "type": "string",
                "oneOf": [
                  {
                    "const": "short",
                    "title": "Short"
                  },
                  {
                    "const": "medium",
                    "title": "Medium"
                  },
                  {
                    "const": "long",
                    "title": "Long"
                  }
                ]
              },
              "required": true
            }
          ]
        }
      ]
    },
    "hold": {
      "id": "hold_bq_1",
      "slot_id": "slot_20261028_1000",
      "service_id": "svc_cut_45",
      "spots": 1,
      "expires_at": "2026-10-25T10:10:00Z",
      "status": "active"
    },
    "extension_negotiated": false
  },
  "when": [
    {
      "at": "2026-10-25T10:00:00Z",
      "step": "create_booking",
      "with": {
        "hold_id": "hold_bq_1",
        "buyer": {
          "first_name": "Dana",
          "last_name": "Levi",
          "email": "dana@example.com",
          "phone_number": "+14155550123"
        }
      },
      "result": {
        "accepted": true,
        "booking_status": "requires_action",
        "actions": [
          {
            "type": "intake_form",
            "status": "pending",
            "continue_url": "https://studio.example.com/forms/sess_77"
          }
        ],
        "messages": []
      }
    }
  ],
  "then": {
    "booking_status": "requires_action",
    "extension_codes_emitted": [],
    "http_status": 200
  },
  "wrong_answers": [
    {
      "behaviour": "return booking_question_answer_missing",
      "violates": "11.4.2 Capability Declaration",
      "why": "The platform does not know the code or the paths, and has no way to answer in band."
    }
  ]
}
