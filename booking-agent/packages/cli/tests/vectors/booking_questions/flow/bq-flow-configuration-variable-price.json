{
  "id": "bq-flow-configuration-variable-price",
  "section": "11.4.3",
  "requirement": "configuration-variable-price",
  "kind": "flow",
  "expect": "accept",
  "notes": "A price that depends on configuration answers is published as pricing.model variable with the dependency disclosed in the question description. No price-delta field exists anywhere.",
  "given": {
    "service": {
      "id": "svc_clean",
      "type": "appointment",
      "booking_question_sets": [
        {
          "id": "size",
          "revision": "r1",
          "purpose": "configuration",
          "completion_timing": "preflight",
          "frequency": "every_booking",
          "items": [
            {
              "kind": "question",
              "id": "sq_ft",
              "label": {
                "plain": "Home size in square feet"
              },
              "schema": {
                "type": "integer",
                "minimum": 100
              },
              "required": true,
              "description": {
                "plain": "Larger homes take longer and cost more; the final price is confirmed after your visit."
              }
            }
          ]
        }
      ],
      "pricing": {
        "model": "variable",
        "currency": "USD"
      }
    }
  },
  "when": [
    {
      "at": "2026-10-25T10:00:00Z",
      "step": "check_eligibility",
      "with": {
        "service_id": "svc_clean",
        "buyer": {
          "first_name": "Dana",
          "last_name": "Levi",
          "email": "dana@example.com",
          "phone_number": "+14155550123"
        },
        "booking_question_submissions": [
          {
            "set_id": "size",
            "revision": "r1",
            "answers": {
              "sq_ft": 2400
            }
          }
        ]
      },
      "result": {
        "eligibility": {
          "decision": "eligible",
          "assessment_token": "bqat_7Hc2kQ",
          "expires_at": "2026-10-25T10:15:00Z"
        }
      }
    }
  ],
  "then": {
    "pricing_model": "variable",
    "price_delta_fields": [],
    "http_status": 200
  },
  "wrong_answers": [
    {
      "behaviour": "add price_delta to each option",
      "violates": "11.4.3 Configuration Sets",
      "why": "The extension would grow its own price math beside the catalog's."
    }
  ]
}
