{
  "id": "bq-flow-retry-preserves-hold",
  "section": "11.4.7",
  "requirement": "booking-question-retry-preserves-hold",
  "kind": "flow",
  "expect": "accept",
  "notes": "A recoverable answer failure keeps the hold active with its original expiry, so the corrected retry converts the same hold. No retry count is asserted (Section 11.4.13).",
  "given": {
    "service": {
      "id": "svc_cut_45",
      "type": "appointment",
      "booking_question_sets": [
        {
          "id": "intake",
          "revision": "r1",
          "purpose": "intake",
          "completion_timing": "before_confirmation",
          "frequency": "every_booking",
          "items": [
            {
              "kind": "question",
              "id": "hair_notes",
              "label": {
                "plain": "Anything the stylist should know?"
              },
              "schema": {
                "type": "string",
                "maxLength": 500
              },
              "required": true
            },
            {
              "kind": "question",
              "id": "hair_length",
              "label": {
                "plain": "Hair length"
              },
              "schema": {
                "type": "string",
                "oneOf": [
                  {
                    "const": "short",
                    "title": "Short"
                  },
                  {
                    "const": "medium",
                    "title": "Medium"
                  },
                  {
                    "const": "long",
                    "title": "Long"
                  }
                ]
              },
              "required": true
            }
          ]
        }
      ]
    },
    "hold": {
      "id": "hold_bq_1",
      "slot_id": "slot_20261028_1000",
      "service_id": "svc_cut_45",
      "spots": 1,
      "expires_at": "2026-10-25T10:10:00Z",
      "status": "active"
    }
  },
  "when": [
    {
      "at": "2026-10-25T10:00:00Z",
      "step": "create_booking",
      "with": {
        "hold_id": "hold_bq_1",
        "buyer": {
          "first_name": "Dana",
          "last_name": "Levi",
          "email": "dana@example.com",
          "phone_number": "+14155550123"
        },
        "booking_question_submissions": [
          {
            "set_id": "intake",
            "revision": "r1",
            "answers": {
              "hair_notes": "Fine hair",
              "hair_length": "xl"
            }
          }
        ]
      },
      "result": {
        "accepted": false,
        "booking_created": false,
        "messages": [
          {
            "type": "error",
            "code": "booking_question_answer_invalid",
            "content": "This answer is not valid.",
            "severity": "recoverable",
            "path": "$.booking_question_submissions[?@.set_id=='intake'].answers['hair_length']"
          }
        ]
      }
    },
    {
      "at": "2026-10-25T10:01:00Z",
      "step": "create_booking",
      "with": {
        "hold_id": "hold_bq_1",
        "buyer": {
          "first_name": "Dana",
          "last_name": "Levi",
          "email": "dana@example.com",
          "phone_number": "+14155550123"
        },
        "booking_question_submissions": [
          {
            "set_id": "intake",
            "revision": "r1",
            "answers": {
              "hair_notes": "Fine hair",
              "hair_length": "long"
            }
          }
        ]
      },
      "result": {
        "accepted": true,
        "booking_id": "bkg_bq_1",
        "booking_status": "confirmed",
        "messages": [],
        "hold_status": "converted"
      }
    }
  ],
  "then": {
    "booking_status": "confirmed",
    "hold_expires_at_during_retry": "2026-10-25T10:10:00Z",
    "http_status": 200
  },
  "wrong_answers": [
    {
      "behaviour": "release the hold on the first refusal",
      "violates": "11.4.11 business item 8",
      "why": "The slot can be taken by another buyer while this buyer fixes one answer."
    }
  ]
}
