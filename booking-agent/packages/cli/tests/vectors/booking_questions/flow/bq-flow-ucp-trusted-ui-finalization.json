{
  "id": "bq-flow-ucp-trusted-ui-finalization",
  "section": "11.4.8",
  "requirement": "ucp-trusted-ui-finalization",
  "kind": "flow",
  "expect": "accept",
  "notes": "Without AP2 Mandates, Complete Checkout is a manual buyer action in a trusted UI, however the preceding Action was processed.",
  "given": {
    "service": {
      "id": "svc_cut_45",
