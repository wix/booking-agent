              },
              "required": true
            },
            {
              "kind": "question",
              "id": "no_show_fee",
              "label": {
                "plain": "I agree to the no-show fee of $30."
              },
              "schema": {
                "type": "boolean",
                "const": true
              },
              "required": true,
              "rendering": "checkbox",
              "collection": "platform_surface"
            }
          ]
        }
      ]
    },
    "negotiated": [
      "dev.usp-protocol.services.paid_bookings",
      "dev.usp-protocol.services.booking_questions"
    ]
  },
  "when": [
