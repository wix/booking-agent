              "answers": {
                "hair_notes": "Fine hair",
                "no_show_fee": true
              },
              "action_id": "act_bq_1"
            }
          ]
        }
      },
      "result": {
        "checkout_status": "ready_for_complete",
        "messages": []
      }
    },
    {
      "at": "2026-10-25T10:01:30Z",
      "step": "complete_checkout",
      "with": {
        "payment_token": "tok_test_001"
      },
      "actor": "buyer_in_trusted_ui",
      "result": {
        "checkout_status": "completed"
      }
