          "revision": "r1",
          "purpose": "intake",
          "completion_timing": "before_confirmation",
          "frequency": "every_booking",
          "items": [
            {
              "kind": "question",
              "id": "hair_notes",
              "label": {
                "plain": "Anything the stylist should know?"
              },
              "schema": {
                "type": "string",
                "maxLength": 500
              },
              "required": true
            },
            {
              "kind": "question",
              "id": "hair_length",
              "label": {
                "plain": "Hair length"
              },
              "schema": {
                "type": "string",
                "oneOf": [
                  {
                    "const": "short",
                    "title": "Short"
                  },
                  {
                    "const": "medium",
                    "title": "Medium"
                  },
                  {
                    "const": "long",
                    "title": "Long"
                  }
                ]
              },
              "required": true
            }
          ]
        },
        {
          "id": "prep",
          "revision": "r1",
          "purpose": "intake",
          "completion_timing": "before_service",
          "frequency": "every_booking",
          "items": [
            {
              "kind": "question",
              "id": "allergies_detail",
              "label": {
                "plain": "Anything we should prepare for?"
              },
              "schema": {
                "type": "string",
                "maxLength": 300
              },
              "required": true
            }
          ]
        }
      ]
    },
    "booking": {
      "id": "bkg_bq_1",
      "status": "in_progress"
    }
  },
  "when": [
    {
      "at": "2026-10-28T10:05:00Z",
      "step": "update_booking",
      "with": {
        "booking_id": "bkg_bq_1",
        "booking_question_submissions": [
          {
            "set_id": "prep",
            "revision": "r1",
