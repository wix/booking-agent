  "variants": [
    {
      "case": "completed",
      "booking_status": "completed",
      "outcome_code": "booking_question_update_not_allowed"
    },
    {
      "case": "no_show",
      "booking_status": "no_show",
      "outcome_code": "booking_question_update_not_allowed"
    },
    {
      "case": "canceled",
      "booking_status": "canceled",
      "outcome_code": "booking_question_update_not_allowed"
    }
  ],
  "wrong_answers": [
    {
      "behaviour": "accept late answers silently",
      "violates": "5.3.3 update permission table",
