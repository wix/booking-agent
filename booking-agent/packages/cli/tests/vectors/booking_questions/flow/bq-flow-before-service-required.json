    "service": {
      "id": "svc_cut_45",
      "type": "appointment",
      "booking_question_sets": [
        {
          "id": "prep",
          "revision": "r1",
          "purpose": "intake",
          "completion_timing": "before_service",
          "frequency": "every_booking",
          "items": [
            {
              "kind": "question",
              "id": "skin_type",
              "label": {
                "plain": "Skin type"
              },
              "schema": {
                "type": "string",
                "oneOf": [
                  {
                    "const": "dry",
                    "title": "Dry"
                  },
                  {
                    "const": "oily",
                    "title": "Oily"
                  },
                  {
                    "const": "mixed",
                    "title": "Combination"
                  }
                ]
              },
              "required": true
            }
          ],
          "due_at": "2026-10-28T08:00:00-04:00"
        }
      ]
    },
    "hold": {
      "id": "hold_bq_1",
      "slot_id": "slot_20261028_1000",
      "service_id": "svc_cut_45",
      "spots": 1,
      "expires_at": "2026-10-25T10:10:00Z",
      "status": "active"
    }
  },
  "when": [
    {
      "at": "2026-10-25T10:00:00Z",
      "step": "create_booking",
      "with": {
        "hold_id": "hold_bq_1",
        "buyer": {
          "first_name": "Dana",
          "last_name": "Levi",
          "email": "dana@example.com",
          "phone_number": "+14155550123"
        },
        "booking_question_submissions": []
      },
      "result": {
        "accepted": true,
        "booking_id": "bkg_bq_1",
        "booking_status": "confirmed",
        "messages": [],
        "actions": [],
        "booking_question_state": [
          {
            "set_id": "prep",
            "revision": "r1",
            "status": "pending",
            "completion_timing": "before_service",
            "due_at": "2026-10-28T08:00:00-04:00",
            "continue_url": "https://studio.example.com/forms/sess_43"
          }
        ]
      }
    },
    {
      "at": "2026-10-26T18:00:00Z",
      "step": "update_booking",
