        "booking_id": "bkg_bq_1",
        "booking_question_submissions": [
          {
            "set_id": "prep",
            "revision": "r1",
            "answers": {
              "skin_type": "dry"
            }
          }
        ]
      },
      "booking_status": "confirmed",
      "result": {
        "accepted": true,
        "messages": [],
        "booking_question_state": [
          {
            "set_id": "prep",
            "revision": "r1",
            "status": "completed",
            "completion_timing": "before_service",
            "answers": {
              "skin_type": "dry"
            }
          }
        ]
      }
