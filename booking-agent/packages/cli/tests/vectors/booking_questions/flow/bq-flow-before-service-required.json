{
  "id": "bq-flow-before-service-required",
  "section": "11.4.7",
  "requirement": "before-service-state",
  "kind": "flow",
  "expect": "accept",
  "notes": "The booking confirms while a required before_service set is pending. The set lives in booking_question_state, never in Booking.actions, and is later completed through PUT /bookings/{booking_id}.",
