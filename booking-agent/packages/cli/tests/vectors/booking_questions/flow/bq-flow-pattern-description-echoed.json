{
  "id": "bq-flow-pattern-description-echoed",
  "section": "11.4.3",
  "requirement": "format-described-and-echoed",
  "kind": "flow",
  "expect": "reject",
  "outcome_code": "booking_question_answer_invalid",
  "notes": "A membership-number format cannot be expressed in the subset, so it is described in plain text. The business's invalid-answer message restates that format. The rejection is business policy beyond the schema, so it is marked policy and not derived.",
  "given": {
    "service": {
