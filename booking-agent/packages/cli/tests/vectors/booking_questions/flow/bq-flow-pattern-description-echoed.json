          "purpose": "intake",
          "completion_timing": "before_confirmation",
          "frequency": "every_booking",
          "items": [
            {
              "kind": "question",
              "id": "member_no",
              "label": {
                "plain": "Membership number"
              },
              "schema": {
                "type": "string",
                "maxLength": 8
              },
              "required": true,
              "description": {
                "plain": "Two capital letters followed by six digits, for example AB123456."
              }
            }
          ]
        }
      ]
    },
    "hold": {
      "id": "hold_bq_1",
      "slot_id": "slot_20261028_1000",
      "service_id": "svc_cut_45",
      "spots": 1,
      "expires_at": "2026-10-25T10:10:00Z",
      "status": "active"
    }
  },
  "when": [
    {
      "at": "2026-10-25T10:00:00Z",
      "step": "create_booking",
      "with": {
        "hold_id": "hold_bq_1",
        "buyer": {
          "first_name": "Dana",
          "last_name": "Levi",
          "email": "dana@example.com",
          "phone_number": "+14155550123"
        },
        "booking_question_submissions": [
          {
            "set_id": "intake",
            "revision": "r1",
            "answers": {
              "member_no": "12345678"
            }
          }
        ]
      },
      "result": {
        "accepted": false,
        "booking_created": false,
        "messages": [
          {
            "type": "error",
            "code": "booking_question_answer_invalid",
