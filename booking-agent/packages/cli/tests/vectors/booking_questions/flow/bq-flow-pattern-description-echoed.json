    "slot_capacity_held": 1,
    "payment_authorized": false,
    "actions_created": [],
    "http_status": 200,
    "outcome_code": "booking_question_answer_invalid",
    "message_restates_format": true
  },
  "wrong_answers": [
    {
      "behaviour": "reply only \"invalid value\"",
      "violates": "11.4.3 Formats the schema cannot express",
