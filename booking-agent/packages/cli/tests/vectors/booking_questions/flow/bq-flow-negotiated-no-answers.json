{
  "id": "bq-flow-negotiated-no-answers",
  "section": "11.4.5",
  "requirement": "booking-questions-negotiated-empty",
  "kind": "flow",
  "expect": "reject",
  "outcome_code": "booking_question_answer_missing",
  "notes": "A negotiated platform sends no booking_question_submissions for a required set. Every required in-band question is reported missing, not as a generic validation_error.",
  "given": {
    "service": {
      "id": "svc_cut_45",
      "type": "appointment",
      "booking_question_sets": [
        {
          "id": "intake",
          "revision": "r1",
          "purpose": "intake",
          "completion_timing": "before_confirmation",
          "frequency": "every_booking",
          "items": [
            {
              "kind": "question",
              "id": "hair_notes",
              "label": {
                "plain": "Anything the stylist should know?"
              },
              "schema": {
                "type": "string",
                "maxLength": 500
              },
              "required": true
            },
            {
              "kind": "question",
              "id": "hair_length",
              "label": {
                "plain": "Hair length"
              },
              "schema": {
                "type": "string",
                "oneOf": [
                  {
                    "const": "short",
                    "title": "Short"
                  },
                  {
                    "const": "medium",
                    "title": "Medium"
                  },
                  {
                    "const": "long",
                    "title": "Long"
                  }
                ]
              },
              "required": true
            }
          ]
        }
      ]
    },
    "hold": {
      "id": "hold_bq_1",
      "slot_id": "slot_20261028_1000",
      "service_id": "svc_cut_45",
      "spots": 1,
      "expires_at": "2026-10-25T10:10:00Z",
      "status": "active"
    }
  },
  "when": [
    {
      "at": "2026-10-25T10:00:00Z",
      "step": "create_booking",
      "with": {
        "hold_id": "hold_bq_1",
        "buyer": {
          "first_name": "Dana",
          "last_name": "Levi",
          "email": "dana@example.com",
          "phone_number": "+14155550123"
        }
      },
      "result": {
        "accepted": false,
        "booking_created": false,
        "messages": [
          {
            "type": "error",
            "code": "booking_question_answer_missing",
            "content": "This answer is required.",
            "severity": "recoverable",
            "path": "$.booking_question_submissions[?@.set_id=='intake'].answers['hair_notes']"
          },
          {
            "type": "error",
            "code": "booking_question_answer_missing",
            "content": "This answer is required.",
            "severity": "recoverable",
            "path": "$.booking_question_submissions[?@.set_id=='intake'].answers['hair_length']"
          }
        ]
      }
    }
  ],
  "then": {
    "booking_created": false,
    "hold": {
      "id": "hold_bq_1",
      "status": "active",
      "expires_at": "2026-10-25T10:10:00Z"
    },
    "slot_capacity_held": 1,
    "payment_authorized": false,
    "actions_created": [],
    "http_status": 200,
    "outcome_code": "booking_question_answer_missing"
  },
  "wrong_answers": [
    {
      "behaviour": "return validation_error",
      "violates": "11.4.5 Request Submission",
      "why": "The platform cannot recover per question from a generic error."
    }
  ]
