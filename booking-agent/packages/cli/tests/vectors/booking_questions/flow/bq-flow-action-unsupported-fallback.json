            },
            "continue_url": "https://studio.example.com/forms/sess_42"
          }
        ],
        "messages": []
      }
    },
    {
      "at": "2026-10-25T10:00:05Z",
      "step": "platform_hands_off",
      "with": {
        "continue_url": "https://studio.example.com/forms/sess_42"
      },
      "result": {
        "handoff": true
      }
    },
    {
      "at": "2026-10-25T10:02:00Z",
      "step": "business_observes",
      "with": {
        "action_id": "act_bq_1"
      },
      "result": {
        "booking_status": "confirmed"
