          "items": [
            {
              "kind": "question",
              "id": "hair_notes",
              "label": {
                "plain": "Anything the stylist should know?"
              },
              "schema": {
                "type": "string",
                "maxLength": 500
              },
              "required": true
            },
            {
              "kind": "question",
              "id": "no_show_fee",
              "label": {
                "plain": "I agree to the no-show fee of $30."
              },
              "schema": {
                "type": "boolean",
                "const": true
              },
              "required": true,
              "rendering": "checkbox",
              "collection": "platform_surface"
            }
          ]
        }
      ]
    },
