          "kind": "question",
          "id": "color_treated",
          "label": {
            "plain": "Is your hair color-treated?"
          },
          "schema": {
            "type": "boolean"
          },
          "required": true
        },
        {
          "kind": "question",
          "id": "last_color",
          "label": {
            "plain": "When was it last colored?"
          },
          "schema": {
            "type": "string",
            "format": "date"
          },
          "required": {
            "question": "color_treated",
            "op": "equals",
            "value": true
          }
        },
        {
          "kind": "question",
          "id": "natural_note",
          "label": {
            "plain": "Describe your natural color"
          },
          "schema": {
