# Shipped defaults for the booking-agent CLI. Do not edit this copy.
#
# Every variable the CLI reads is listed here (core library variables are in
# booking_agent/defaults.env). Override one in the process environment, in a file
# passed with `booking-agent flow init --env-file` or BOOKING_AGENT_ENV_FILE, or in
# ~/.booking-agent/.env (`booking-agent config init` creates it). `booking-agent
# config show` prints every effective value and where it came from.
#
# Lines starting with `# NAME=` have no default. Nothing needs configuring for a
# basic booking. Agents never write tokens into env files.

# --- Config files ----------------------------------------------------------------
# One env file for hosts that set it once; saved with the session like --env-file.
# BOOKING_AGENT_ENV_FILE=

# --- Address and time zone ---------------------------------------------------------
# Address lookup (OpenStreetMap Nominatim search API, https only).
BOOKING_AGENT_GEOCODER_URL=https://nominatim.openstreetmap.org/search
# Look up the buyer's time zone from their confirmed address (0 to turn off).
BOOKING_AGENT_BUYER_TIMEZONE_LOOKUP=1

# --- Sessions and tools -------------------------------------------------------------
# Booking sessions kept on this device.
BOOKING_AGENT_MAX_SESSIONS=30
# The Link CLI executable.
LINK_CLI_BIN=link-cli

# --- Google Calendar (operator setup) -----------------------------------------------
# Calendar checking with a local sign-in needs the operator's OAuth app. Set
# GOOGLE_CALENDAR_CLIENT_ID and GOOGLE_CALENDAR_CLIENT_SECRET in ~/.booking-agent/.env.
# Hosts with their own calendar connector (Base44) inject the token instead:
# GOOGLECALENDAR_ACCESS_TOKEN=
