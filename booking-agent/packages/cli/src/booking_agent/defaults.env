# Shipped defaults for booking-agent. Do not edit this copy.
# Override a value in the process environment or ~/.booking-agent/.env.
# `booking-agent config show` prints each effective value and its source.
# A `# NAME=` line has no default.

# --- Platform identity ---------------------------------------------------------
# Fetched by businesses from the USP-Agent and UCP-Agent headers.
USP_AGENT_PROFILE_URL=https://profile.booking-agent.dev/platform-profile.json
USP_REGISTRY_URL=https://www.wixapis.com/_api/usp-registry/registry/search_services
USP_PLATFORM_NAME=USP Agent
USP_PLATFORM_CONTACT=support@booking-agent.dev

# --- Install -------------------------------------------------------------------
# Sessions, tokens, and traces. Holds the user .env, so override it only in the
# process environment.
BOOKING_AGENT_SESSION_DIR=~/.booking-agent
# Absolute folder a host keeps between runs. When set, booking-agent links its state and the
# Link sign-in into it by itself before every command.
# BOOKING_AGENT_PERSISTENT_ROOT=
# Set to `none` by a host that keeps this runtime's files between conversations itself, so
# `flow init` does not ask the agent how state is kept.
# BOOKING_AGENT_PERSISTENCE=
BOOKING_AGENT_MAX_SESSIONS=30
LINK_CLI_BIN=link-cli

# --- Authorization -------------------------------------------------------------
# Booking-scoped credential floor: required or preferred.
BOOKING_AGENT_USP_AUTH_SCOPED_CREDENTIAL=required

# --- HTTP (seconds unless named otherwise) -------------------------------------
BOOKING_AGENT_HTTP_TIMEOUT=15
BOOKING_AGENT_HTTP_CONNECT_TIMEOUT=5
BOOKING_AGENT_HTTP_MAX_RETRIES=4
BOOKING_AGENT_HTTP_BACKOFF_BASE=1.0
BOOKING_AGENT_HTTP_BACKOFF_MAX=300.0
BOOKING_AGENT_CIRCUIT_FAILURE_THRESHOLD=5
BOOKING_AGENT_CIRCUIT_COOLDOWN_SECONDS=30
BOOKING_AGENT_CIRCUIT_DISABLED=0
# Minimum gap between requests to one business host.
BOOKING_AGENT_MERCHANT_REQUEST_DELAY_MS=200
BOOKING_AGENT_MERCHANT_HOST_CONCURRENCY=3
BOOKING_AGENT_DISCOVERY_CONCURRENCY=8
BOOKING_AGENT_PROFILE_CACHE_TTL_SECONDS=900
# 1 writes a redacted request log to <session dir>/http_trace.log.
BOOKING_AGENT_HTTP_TRACE=0
# 1 writes money-path JSON event lines to stderr. Off by default because many
# agent hosts merge stderr into the stdout JSON they parse.
BOOKING_AGENT_STDERR_EVENTS=0
# 0 stops automatic fault reports: faults the user never saw, about a business's
# profile or catalog or the assistant's own code, sent with no user data.
BOOKING_AGENT_FAULT_REPORTS=1

# --- Address -------------------------------------------------------------------
BOOKING_AGENT_GEOCODER_URL=https://nominatim.openstreetmap.org/search

# --- Google Calendar -----------------------------------------------------------
# The operator's OAuth app, needed only for a local calendar sign-in.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_PORT=8098
# A folder under the session dir, or an absolute path.
GOOGLE_CALENDAR_TOKEN_CACHE_DIR=.google-calendar-tokens

# --- Updates -------------------------------------------------------------------
# 0 stops update checks; the installed assistant keeps working either way.
BOOKING_AGENT_UPDATE_CHECK=1
BOOKING_AGENT_RELEASE_INDEX_URL=https://raw.githubusercontent.com/wix/booking-agent/master/booking-agent/release-notes/index.json
